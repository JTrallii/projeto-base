# ============================================================
# APPLICATION
# ============================================================

# URL pública/origem confiável da aplicação.
#
# Desenvolvimento:
APP_URL=http://localhost:3000
#
# Produção:
# APP_URL=https://seu-dominio.com


# ============================================================
# SUPABASE
# ============================================================

# URL do projeto Supabase.
#
# Projeto hospedado:
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
#
# Supabase local:
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321


# Publishable Key do Supabase.
#
# Pode ser utilizada no browser.
# Nunca coloque uma Secret Key nesta variável.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO


# Secret Key do Supabase.
#
# SOMENTE servidor.
# Nunca usar em Client Components.
# Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_EXEMPLO


# ============================================================
# UPSTASH REDIS
# ============================================================

# REST URL criada no painel da Upstash.
UPSTASH_REDIS_REST_URL=https://SEU_DATABASE.upstash.io


# Token REST da Upstash.
# Segredo de servidor.
UPSTASH_REDIS_REST_TOKEN=SEU_TOKEN_UPSTASH


# ============================================================
# RATE LIMIT
# ============================================================

# Segredo utilizado para aplicar HMAC nos identificadores
# usados pelo rate limiting.
#
# NÃO reutilize senha, JWT secret ou chave do Supabase.
#
# Exemplo para gerar:
# openssl rand -hex 32
RATE_LIMIT_HASH_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_FORTE


# ============================================================
# CLIENT IP
# ============================================================

# Na Vercel o projeto utiliza os headers confiáveis
# fornecidos pela própria plataforma.
#
# Fora da Vercel, configure explicitamente qual header
# do seu proxy/CDN deve ser considerado confiável.
#
# Cloudflare:
# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip
#
# Outro proxy controlado:
# TRUSTED_CLIENT_IP_HEADER=x-real-ip

# TRUSTED_CLIENT_IP_HEADER=cf-connecting-ip


# ============================================================
# CLOUDFLARE TURNSTILE
# ============================================================

# Site Key.
#
# Pode ficar disponível no navegador.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=SEU_TURNSTILE_SITE_KEY


# Secret Key utilizada pelo Supabase Auth para validar CAPTCHA.
#
# Segredo de servidor.
SUPABASE_AUTH_CAPTCHA_SECRET=SEU_TURNSTILE_SECRET_KEY


# ------------------------------------------------------------
# TURNSTILE - CHAVES DE TESTE LOCAL
# ------------------------------------------------------------
#
# Cloudflare disponibiliza estas chaves especificamente
# para desenvolvimento/testes.
#
# Site Key de teste:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# Secret Key de teste:
# SUPABASE_AUTH_CAPTCHA_SECRET=1x0000000000000000000000000000000AA


# ============================================================
# SUPABASE LOCAL / STUDIO - OPCIONAL
# ============================================================

# Usada somente se quiser habilitar recursos de IA
# dentro do Supabase Studio local.
#
# Não é necessária para executar a aplicação.
# OPENAI_API_KEY=


# ============================================================
# SUPABASE SMS / TWILIO - OPCIONAL
# ============================================================

# O projeto-base atualmente não depende de SMS.
#
# Existe apenas como exemplo para uma implementação futura
# utilizando a configuração do Supabase.
#
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=


# ============================================================
# S3 / SUPABASE EXPERIMENTAL - OPCIONAL
# ============================================================

# Essas variáveis só são necessárias caso recursos S3
# experimentais do Supabase sejam habilitados.
#
# S3_HOST=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=